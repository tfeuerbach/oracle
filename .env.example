# Required
DISCORD_TOKEN=your-bot-token-here
OPENAI_API_KEY=sk-your-openai-key-here

# Whisper transcription settings
WHISPER_MODEL=whisper-1
WHISPER_MODE=api          # "api" (OpenAI) or "local" (self-hosted whisper CLI)
LOCAL_WHISPER_MODEL=base  # only used when WHISPER_MODE=local

# Embedding settings (semantic search)
EMBEDDING_PROVIDER=openai         # "openai" or "local" (sentence-transformers)
LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2  # only used when EMBEDDING_PROVIDER=local
SEMANTIC_SIMILARITY_THRESHOLD=0.3 # minimum cosine similarity for semantic results (0.0-1.0)

# Concurrency — how many videos to transcribe at once (default: 5)
MAX_CONCURRENT_TRANSCRIPTIONS=5

# Max video duration in seconds — videos longer than this are skipped (default: 3600)
MAX_VIDEO_DURATION=3600

# Root directory for data/ and tmp/ (default: current directory)
# ORACLE_DATA_DIR=.

# Optional: cookies for age-restricted or login-required videos
# YTDLP_COOKIES_FILE=/path/to/cookies.txt       # Netscape-format cookies file
# YTDLP_COOKIES_BROWSER=firefox                  # or: chrome, brave, edge, safari
